# Copy outside the repository and set values suitable for one AutoDL instance.
# Never place Provider or service tokens in this file.
KERNELBLASTER_STATE_DIR=
KERNELBLASTER_GPU_DEVICE=0
KERNELBLASTER_ALLOWED_TARGET_ARCHES=
KERNELBLASTER_GPU_MAX_CONCURRENCY=1
# Override these with complete image references (including a tag or digest) when
# a different compatible toolkit is required.  Existing Compose defaults remain
# compatible with the repository's local development image names.
KERNELBLASTER_CONTROL_IMAGE=
KERNELBLASTER_GPU_SUPERVISOR_IMAGE=
KERNELBLASTER_PROFILER_IMAGE=
KERNELBLASTER_BASELINE_IMAGE=
